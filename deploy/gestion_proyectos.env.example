# /etc/gestion_proyectos/gestion_proyectos.env  (chmod 640, root:gestion_proyectos). NO commitear el real.
# SECRET_KEY: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=proyectos.walkcode.pe
CSRF_TRUSTED_ORIGINS=https://proyectos.walkcode.pe
BEHIND_HTTPS_PROXY=true
APP_TIMEZONE=America/Lima

# Esta app lee MYSQL_* (no DB_*)
MYSQL_DATABASE=gestion_proyectos_db
MYSQL_USER=gestion_proyectos_app
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
